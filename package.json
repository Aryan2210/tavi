{
  "name": "tavi",
  "version": "0.1.0",
  "private": true,
  "description": "TAVI – Talkative Vision: a voice-first visual assistant for people who are blind or visually impaired.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "license": "UNLICENSED",
  "author": "Aryan Nandu",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
